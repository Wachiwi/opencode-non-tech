{
  "$schema": "https://opencode.ai/config.json",
  // Container-Version: identisch zur Projekt-Config, aber mit CONTAINER-Pfaden.
  // Wird nach /root/.config/opencode gemountet (siehe docker-compose.yml).

  "model": "openrouter/~z-ai/glm-flash-latest",
  "default_agent": "planer",

  "providers": {
    "openrouter": {
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "plugins": ["opencode-mem@latest"],

  "mcp": {
    "servers": {
      "rag": {
        "type": "local",
        "command": ["mcp-local-rag"],
        "environment": {
          "BASE_DIR": "/workspace/Datenblaetter",
          "DB_PATH": "/data/.rag-index",
          "CACHE_DIR": "/data/.rag-cache"
        }
      },
      "office": {
        "type": "local",
        "command": ["npx", "-y", "kordoc", "mcp"],
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp"]
      }
    }
  },

  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" }
  ],

  "experimental": {
    "todo": true
  }
}
